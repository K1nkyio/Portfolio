PORT=3001
# Replace USER, PASSWORD, HOST, and DATABASE with your actual PostgreSQL details.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSL=true
TRUST_PROXY=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=you@example.com
# Choose "resend" or "smtp". Resend settings take priority when selected.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Portfolio <contact@example.com>
